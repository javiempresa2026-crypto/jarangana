        },
        "b2": {
          "type": "qa",
          "settings": {
            "q": "¿En qué superficies NO funcionan?",
            "a": "<p>Gotelé, pintura, madera sin lacar, papel pintado y juntas de azulejo. Necesitan una superficie lisa y no porosa.</p>"
