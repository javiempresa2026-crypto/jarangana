        "b2": {
          "type": "qa",
          "settings": {
            "q": "¿Por qué hay que esperar 24 horas?",
            "a": "<p>El adhesivo va ganando agarre con las horas. Si lo mojas o lo cargas antes, puede no agarrar del todo. Paciencia: es el paso más importante.</p>"
          }
