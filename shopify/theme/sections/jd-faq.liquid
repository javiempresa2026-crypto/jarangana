{{ 'jarandana.css' | asset_url | stylesheet_tag }}
<section class="jd jd--{{ section.settings.bg }}" id="faq">
  {%- render 'jd-bg', s: section -%}
  <div class="jd__wrap">
    <div class="jd__center">
      {%- if section.settings.eyebrow != blank -%}<p class="jd__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.sticker != blank -%}<span class="jd-sticker">{{ section.settings.sticker | escape }}</span>{%- endif -%}
      <h2 class="jd__h">{% render 'jd-hl', t: section.settings.heading %}</h2>
    </div>
    <div class="jd-faq">
      {%- for b in section.blocks -%}
      <details {{ b.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
        <summary>{{ b.settings.q }}</summary>
        <div class="jd-faq__a">{{ b.settings.a }}</div>
      </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.link_label != blank -%}
    <p class="jd-note"><a href="{{ section.settings.link | default: '/pages/preguntas-frecuentes' }}" style="color:inherit;font-weight:700">{{ section.settings.link_label }} →</a></p>
    {%- endif -%}
  </div>
</section>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for b in section.blocks -%}{"@type":"Question","name":{{ b.settings.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ b.settings.a | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
</script>
{%- endif -%}
{% schema %}
{
 "name": "jarandana · Preguntas",
 "settings": [
  {
   "type": "select",
   "id": "bg",
   "label": "Fondo",
   "default": "cream",
   "options": [
    {
     "value": "cream",
     "label": "Crema"
    },
    {
     "value": "sand",
     "label": "Arena"
    },
    {
     "value": "white",
     "label": "Blanco"
    },
    {
     "value": "pop",
     "label": "Pop (manchas de color)"
    },
    {
     "value": "orange",
     "label": "Naranja intenso"
    },
    {
     "value": "teal",
     "label": "Turquesa"
    },
    {
     "value": "sun",
     "label": "Amarillo sol"
    }
   ]
  },
  {
   "type": "text",
   "id": "eyebrow",
   "label": "Antetítulo",
   "default": "Dudas"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Título",
   "default": "Preguntas frecuentes"
  },
  {
   "type": "checkbox",
   "id": "open_first",
   "label": "Abrir la primera",
   "default": true
  },
  {
   "type": "text",
   "id": "link_label",
   "label": "Texto del enlace",
   "default": "Ver todas las preguntas"
  },
  {
   "type": "url",
   "id": "link",
   "label": "Enlace"
  },
  {
   "type": "header",
   "content": "Decoración"
  },
  {
   "type": "image_picker",
   "id": "bg_image",
   "label": "Imagen de fondo (con velo de color)"
  },
  {
   "type": "select",
   "id": "pattern",
   "label": "Dibujo de fondo",
   "default": "auto",
   "options": [
    {
     "value": "auto",
     "label": "Automático según el color"
    },
    {
     "value": "azulejo",
     "label": "Azulejo"
    },
    {
     "value": "dots",
     "label": "Lunares"
    },
    {
     "value": "bubbles",
     "label": "Burbujas"
    },
    {
     "value": "stripes",
     "label": "Rayas"
    },
    {
     "value": "none",
     "label": "Ninguno"
    }
   ]
  },
  {
   "type": "text",
   "id": "sticker",
   "label": "Pegatina sobre el título (opcional)"
  },
  {
   "type": "paragraph",
   "content": "Pon palabras del título entre [corchetes] para resaltarlas."
  }
 ],
 "blocks": [
  {
   "type": "qa",
   "name": "Pregunta",
   "settings": [
    {
     "type": "text",
     "id": "q",
     "label": "Pregunta",
     "default": "¿De verdad no hay que taladrar?"
    },
    {
     "type": "richtext",
     "id": "a",
     "label": "Respuesta",
     "default": "<p>No. Se fija con adhesivo sobre superficies lisas.</p>"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "jarandana · Preguntas"
  }
 ]
}
{% endschema %}
