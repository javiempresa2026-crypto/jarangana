{{ 'jarandana.css' | asset_url | stylesheet_tag }}
<section class="jd jd--{{ section.settings.bg }}" id="faq">
  <div class="jd__wrap">
    <div class="jd__center">
      {%- if section.settings.eyebrow != blank -%}<p class="jd__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="jd__h">{{ section.settings.heading }}</h2>
    </div>
    <div class="jd-faq">
      {%- for b in section.blocks -%}
      <details {{ b.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
        <summary>{{ b.settings.q }}</summary>
        <div class="jd-faq__a">{{ b.settings.a }}</div>
      </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.link_label != blank -%}
    <p class="jd-note"><a href="{{ section.settings.link | default: '/pages/preguntas-frecuentes' }}" style="color:inherit;font-weight:700">{{ section.settings.link_label }} →</a></p>
    {%- endif -%}
  </div>
</section>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for b in section.blocks -%}{"@type":"Question","name":{{ b.settings.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ b.settings.a | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
</script>
{%- endif -%}
{% schema %}
{
  "name": "jarandana · Preguntas",
  "settings": [
    {"type":"select","id":"bg","label":"Fondo","default":"cream","options":[{"value":"cream","label":"Crema"},{"value":"sand","label":"Arena"},{"value":"white","label":"Blanco"}]},
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Dudas"},
    {"type":"text","id":"heading","label":"Título","default":"Preguntas frecuentes"},
    {"type":"checkbox","id":"open_first","label":"Abrir la primera","default":true},
    {"type":"text","id":"link_label","label":"Texto del enlace","default":"Ver todas las preguntas"},
    {"type":"url","id":"link","label":"Enlace"}
  ],
  "blocks": [
    {"type":"qa","name":"Pregunta","settings":[
      {"type":"text","id":"q","label":"Pregunta","default":"¿De verdad no hay que taladrar?"},
      {"type":"richtext","id":"a","label":"Respuesta","default":"<p>No. Se fija con adhesivo sobre superficies lisas.</p>"}
    ]}
  ],
  "presets": [{"name":"jarandana · Preguntas"}]
}
{% endschema %}
