{{ 'jarandana.css' | asset_url | stylesheet_tag }}
<div class="jd-pw">
  <div class="jd-pat jd-pat--azulejo" aria-hidden="true"></div>
  <div class="jd-pw__box">
    <div class="jd-pw__logo">
      {%- if settings.logo_inverse != blank -%}
        {{ settings.logo_inverse | image_url: width: 520 | image_tag: alt: shop.name, loading: 'eager' }}
      {%- else -%}<span>jarandana</span>{%- endif -%}
    </div>
    <span class="jd-sticker">{{ section.settings.sticker }}</span>
    <h1 class="jd-pw__h">{% render 'jd-hl', t: section.settings.heading %}</h1>
    <p class="jd-pw__p">{{ section.settings.text }}</p>
    <ul class="jd-pw__chips">
      <li>🚿 Baldas de ducha</li><li>💡 Luces con sensor</li><li>🚰 Grifo 1080°</li><li>🧽 Kit fregadero</li>
    </ul>
    <div class="jd-pw__card">
      <p class="jd-pw__offer">🎁 Apúntate y llévate un <b>-10 %</b> el día que abramos</p>
      {%- form 'customer', id: 'jd-pw-news', class: 'jd-pw__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,prelanzamiento">
        {%- if form.posted_successfully? -%}
          <p class="jd-pw__ok">¡Estás dentro! 🎉 Te avisaremos. Tu código: <b>BIENVENIDA10</b></p>
        {%- else -%}
          <label class="visually-hidden" for="jd-pw-email">Email</label>
          <input id="jd-pw-email" type="email" name="contact[email]" placeholder="tu@email.com" required autocomplete="email">
          <button type="submit">Avísame 🔔</button>
          {%- if form.errors -%}<p class="jd-pw__err">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      <p class="jd-pw__small">Sin spam. Al apuntarte aceptas la <a href="/pages/politica-de-privacidad">Política de privacidad</a>.</p>
    </div>
    <ul class="jd-pw__trust">
      <li>🚚 Envío GRATIS desde 35 €</li><li>↩️ 14 días para devolver</li><li>🔒 Pago seguro</li>
    </ul>
    <button type="button" class="jd-pw__enter" on:click="#password-form/showDialog">🔑 Tengo la contraseña</button>
  </div>
</div>
{% schema %}
{
  "name": "jarandana · Próximamente",
  "settings": [
    {"type":"text","id":"sticker","label":"Pegatina","default":"Muy pronto"},
    {"type":"text","id":"heading","label":"Título ([texto] = resaltado)","default":"Tu casa, [sin taladrar]."},
    {"type":"textarea","id":"text","label":"Texto","default":"Estamos preparando accesorios de baño y cocina que se ponen sin agujeros, aguantan la ducha y se vienen contigo cuando te mudas. Abrimos muy pronto."}
  ],
  "presets": [{"name":"jarandana · Próximamente"}]
}
{% endschema %}
