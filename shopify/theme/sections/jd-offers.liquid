{{ 'jarandana.css' | asset_url | stylesheet_tag }}
<section class="jd jd--{{ section.settings.bg }}" id="ofertas">
  {%- render 'jd-bg', s: section -%}
  <div class="jd__wrap">
    <div class="jd__center">
      {%- if section.settings.eyebrow != blank -%}<p class="jd__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.sticker != blank -%}<span class="jd-sticker">{{ section.settings.sticker | escape }}</span>{%- endif -%}
      <h2 class="jd__h">{% render 'jd-hl', t: section.settings.heading %}</h2>
      {%- if section.settings.text != blank -%}<div class="jd__lead">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="jd-offers">
      {%- for b in section.blocks -%}
      <div class="jd-offer jd-offer--{{ b.settings.color }}" {{ b.shopify_attributes }}>
        {%- if b.settings.tag != blank -%}<span class="jd-offer__tag">{{ b.settings.tag }}</span>{%- endif -%}
        <p class="jd-offer__big">{{ b.settings.big }}</p>
        <h3 class="jd-offer__t">{{ b.settings.title }}</h3>
        {%- if b.settings.text != blank -%}<div class="jd-offer__d">{{ b.settings.text }}</div>{%- endif -%}
        {%- if b.settings.code != blank -%}
          <button type="button" class="jd-offer__code" data-code="{{ b.settings.code | escape }}" onclick="navigator.clipboard&&navigator.clipboard.writeText(this.dataset.code);this.classList.add('is-ok');this.querySelector('span').textContent='¡Copiado!';">
            <strong>{{ b.settings.code }}</strong><span>Copiar código</span>
          </button>
        {%- endif -%}
        {%- if b.settings.btn_label != blank -%}
          <a class="jd__btn jd-offer__btn" href="{{ b.settings.btn_link | default: routes.all_products_collection_url }}">{{ b.settings.btn_label }}</a>
        {%- endif -%}
      </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="jd-note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
 "name": "jarandana · Ofertas",
 "settings": [
