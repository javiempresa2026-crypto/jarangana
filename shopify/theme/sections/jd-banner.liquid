   "default": "auto",
   "options": [
    {
     "value": "auto",
     "label": "Automático según el color"
    },
    {
     "value": "azulejo",
     "label": "Azulejo"
    },
    {
     "value": "dots",
     "label": "Lunares"
    },
    {
     "value": "bubbles",
     "label": "Burbujas"
    },
    {
     "value": "stripes",
     "label": "Rayas"
    },
    {
     "value": "none",
     "label": "Ninguno"
    }
   ]
  },
  {
   "type": "text",
   "id": "sticker",
   "label": "Pegatina sobre el título (opcional)"
  },
  {
   "type": "paragraph",
   "content": "Pon palabras del título entre [corchetes] para resaltarlas."
  }
 ],
 "presets": [
  {
   "name": "jarandana · Banner"
  }
 ]
}
