{{ 'jarandana.css' | asset_url | stylesheet_tag }}
<section class="jd jd--{{ section.settings.bg }}">
  <div class="jd__wrap">
    {%- if section.settings.heading != blank -%}
    <div class="jd__center" style="margin-bottom:28px">
      {%- if section.settings.eyebrow != blank -%}<p class="jd__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="jd__h">{{ section.settings.heading }}</h2>
    </div>
    {%- endif -%}
    <div class="jd-ben">
      {%- for b in section.blocks -%}
      <div class="jd-ben__item" {{ b.shopify_attributes }}>
        <span class="jd-ben__ico">{% render 'jd-icon', icon: b.settings.icon %}</span>
        <p class="jd-ben__t">{{ b.settings.title }}</p>
        <p class="jd-ben__d">{{ b.settings.text }}</p>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "jarandana · Ventajas",
  "settings": [
    {"type":"select","id":"bg","label":"Fondo","default":"white","options":[{"value":"cream","label":"Crema"},{"value":"sand","label":"Arena"},{"value":"white","label":"Blanco"},{"value":"pop","label":"Pop (manchas de color)"},{"value":"orange","label":"Naranja intenso"},{"value":"teal","label":"Turquesa"},{"value":"sun","label":"Amarillo sol"}]},
    {"type":"text","id":"eyebrow","label":"Antetítulo"},
    {"type":"text","id":"heading","label":"Título"}
  ],
  "blocks": [
    {"type":"item","name":"Ventaja","settings":[
      {"type":"select","id":"icon","label":"Icono","default":"check","options":[{"value":"check","label":"Check"},{"value":"drill","label":"Sin taladro"},{"value":"truck","label":"Envío"},{"value":"return","label":"Devolución"},{"value":"lock","label":"Pago seguro"},{"value":"shield","label":"Garantía"},{"value":"drop","label":"Agua"},{"value":"home","label":"Casa"},{"value":"clock","label":"Tiempo"},{"value":"chat","label":"Chat"}]},
      {"type":"text","id":"title","label":"Título","default":"Sin taladro"},
      {"type":"text","id":"text","label":"Texto","default":"Se pega al azulejo en un minuto."}
    ]}
  ],
  "presets": [{"name":"jarandana · Ventajas"}]
}
{% endschema %}
